<?xml version="1.0" encoding="UTF-8"?>
<!--
	Local fallback for the GitHub workflow .github/workflows/build-zip.yml.

	All steps of the release run via bin/build-release.sh, which is also used by the GitHub workflow
	and by the Taskfile. So all of them create a zip with the same content.

	Not possible here (only in the GitHub workflow): the Plugin Check (PCP), the SBOM and the GitHub
	release itself. The smoke test in WordPress Playground runs here too, if npx.path is set in
	build.properties.

	Usage in this directory:
	  ant build        - runs the checks and creates ../releases/<slug>_<version>.zip
	  ant release-zip  - creates the zip without checks and tests
	  ant init         - prepares the checkout for development
	  ant -p           - lists all targets

	Needs: Ant 1.9.1 or newer, bash, composer, npm, rsync and zip.
-->
<project name="easy-language" basedir="." default="help" xmlns:if="ant:if" xmlns:unless="ant:unless">

	<!-- load the local configuration. -->
	<loadproperties srcFile="build.properties" />

	<!-- directories. -->
	<property name="src.dir" location="../" />
	<property name="build.dir" location="../releases" />
	<property name="log.dir" location="./" />

	<!-- check the configuration. -->
	<fail unless="plugin.slug" message="plugin.slug is missing in build.properties." />
	<fail unless="plugin.version" message="plugin.version is missing in build.properties." />
	<fail unless="npm.path" message="npm.path is missing in build.properties." />
	<fail unless="composer.path" message="composer.path is missing in build.properties." />
	<fail message="Do not run as root!">
		<condition>
			<equals arg1="root" arg2="${user.name}" />
		</condition>
	</fail>

	<!-- only version numbers like 4.0.0 or 4.0.0-beta.1 (checked here to stop before the long build, same rule as in bin/build-release.sh). -->
	<fail message="'${plugin.version}' is not a version number like 4.0.0 or 4.0.0-beta.1.">
		<condition>
			<not>
				<matches string="${plugin.version}" pattern="^[0-9]+\.[0-9]+\.[0-9]+(-[0-9A-Za-z.]+)?$" />
			</not>
		</condition>
	</fail>

	<!-- the zip of the release. -->
	<property name="release.zip" location="${build.dir}/${plugin.slug}_${plugin.version}.zip" />

	<!-- prepare the checkout: PHP packages (with Mozart), blocks, sidebar, page builder fields and react-dialog. -->
	<target name="init" description="prepares the checkout for development">
		<exec dir="${src.dir}" failonerror="true" executable="bash" output="${log.dir}/init.txt">
			<env key="RELEASE_SLUG" value="${plugin.slug}" />
			<env key="COMPOSER_BIN" value="${composer.path}" />
			<env key="NPM_BIN" value="${npm.path}" />
			<arg line="bin/build-release.sh init" />
		</exec>
	</target>

	<!-- code checks (same as in .github/workflows/testing.yml). Skip them with skip.checks=true. -->
	<target name="checks" description="runs PHPStan, PHPCS and the PHP compatibility check" unless="${skip.checks}">
		<exec dir="${src.dir}" failonerror="true" executable="${composer.path}">
			<arg line="validate --strict --no-check-publish --no-check-version" />
		</exec>
		<exec dir="${src.dir}" failonerror="true" executable="vendor/bin/phpstan">
			<arg line="analyse --no-progress" />
		</exec>
		<exec dir="${src.dir}" failonerror="true" executable="vendor/bin/phpcs">
			<arg line="." />
		</exec>
		<exec dir="${src.dir}" failonerror="true" executable="vendor/bin/phpcs">
			<arg line="-p app --standard=PHPCompatibilityWP --runtime-set testVersion 8.2- --ignore=*/Dependencies/*" />
		</exec>
	</target>

	<!-- PHPUnit tests (need a database, see composer.json). Run them with run.tests=true. -->
	<target name="php-unit-tests" description="runs the PHPUnit tests" if="${run.tests}">
		<exec dir="${src.dir}" failonerror="true" executable="${composer.path}" output="${log.dir}/php-unit-tests-1.txt">
			<arg line="test-install-during-build" />
		</exec>
		<exec dir="${src.dir}" failonerror="true" executable="${composer.path}" output="${log.dir}/php-unit-tests-2.txt">
			<arg line="test" />
		</exec>
	</target>

	<!-- generate the hook documentation (not part of the release). -->
	<target name="generate-documentation" description="generates doc/hooks.md">
		<exec dir="${src.dir}" failonerror="true" executable="vendor/bin/wp-documentor">
			<arg line="parse app --format=markdown --output=doc/hooks.md --prefix=easy_language_ --exclude=Section.php --exclude=Tab.php --exclude=Import.php --exclude=Export.php --exclude=Field_Base.php --exclude=Settings.php --exclude=Page.php --exclude=Rest.php --exclude=Transients.php --exclude=Post_Object.php" />
		</exec>
	</target>

	<!--
		Create the release zip with the same script as the GitHub workflow.

		The development state of vendor/ is restored at the end in every case (also if a step failed),
		then the build stops with the error of the failed step.
	-->
	<target name="create-release-zip">
		<delete file="${release.zip}" />

		<!-- install the PHP packages without dev packages and generate the release autoloader. -->
		<exec dir="${src.dir}" failonerror="false" resultproperty="prepare.result" executable="bash" output="${log.dir}/release-prepare.txt">
			<env key="COMPOSER_BIN" value="${composer.path}" />
			<arg line="bin/build-release.sh prepare" />
		</exec>
		<condition property="release.failed" value="prepare (see ${log.dir}/release-prepare.txt)">
			<not><equals arg1="${prepare.result}" arg2="0" /></not>
		</condition>

		<!-- collect the files of the release in dist/ and set the version number. -->
		<exec unless:set="release.failed" dir="${src.dir}" failonerror="false" resultproperty="collect.result" executable="bash" output="${log.dir}/release-collect.txt">
			<env key="RELEASE_SLUG" value="${plugin.slug}" />
			<arg value="bin/build-release.sh" />
			<arg value="collect" />
			<arg value="${plugin.version}" />
		</exec>
		<condition property="release.failed" value="collect (see ${log.dir}/release-collect.txt)">
			<and>
				<isset property="collect.result" />
				<not><equals arg1="${collect.result}" arg2="0" /></not>
			</and>
		</condition>

		<!-- create the zip. -->
		<exec unless:set="release.failed" dir="${src.dir}" failonerror="false" resultproperty="zip.result" executable="bash" output="${log.dir}/release-zip.txt">
			<env key="RELEASE_SLUG" value="${plugin.slug}" />
			<arg value="bin/build-release.sh" />
			<arg value="zip" />
			<arg value="${release.zip}" />
		</exec>
		<condition property="release.failed" value="zip (see ${log.dir}/release-zip.txt)">
			<and>
				<isset property="zip.result" />
				<not><equals arg1="${zip.result}" arg2="0" /></not>
			</and>
		</condition>

		<!-- get the dev packages back for development - in every case. -->
		<exec dir="${src.dir}" failonerror="true" executable="bash" output="${log.dir}/release-restore.txt">
			<env key="COMPOSER_BIN" value="${composer.path}" />
			<arg line="bin/build-release.sh restore" />
		</exec>

		<fail if="release.failed" message="The release could not be created, failed step: ${release.failed}" />
		<echo message="Release created: ${release.zip}" />
	</target>

	<!-- smoke test the zip in WordPress Playground (same blueprint as in the workflow). Runs only if npx.path is set. Needs Node 24 and internet access. Skip it with skip.smoke=true. -->
	<target name="smoke-test" description="tests the zip in WordPress Playground" if="npx.path" unless="${skip.smoke}">
		<exec dir="${src.dir}" failonerror="true" executable="bash" output="${log.dir}/smoke-test.txt">
			<env key="RELEASE_SLUG" value="${plugin.slug}" />
			<env key="NPX_BIN" value="${npx.path}" />
			<arg value="bin/build-release.sh" />
			<arg value="smoke" />
			<arg value="${release.zip}" />
		</exec>
	</target>

	<!-- create only the release zip, without checks, tests and smoke test. -->
	<target name="release-zip" description="creates the release zip without checks and tests" depends="init">
		<antcall target="create-release-zip" />
	</target>

	<!-- create the release zip: the same steps as .github/workflows/build-zip.yml. -->
	<target name="build" description="runs the checks and builds the release zip" depends="init,checks,php-unit-tests">
		<!-- the checks above need the dev packages, so the release zip is created afterwards. -->
		<antcall target="create-release-zip" />
		<antcall target="smoke-test" />
		<echo message="Done: ${release.zip}" />
	</target>

	<target name="help">
		<java classname="org.apache.tools.ant.Main">
			<arg value="-projecthelp" />
			<arg value="-buildfile" />
			<arg value="build.xml" />
		</java>
	</target>

</project>
